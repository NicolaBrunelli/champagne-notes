---
interface Props { eyebrow: string; title: string; text: string; }
const { eyebrow, title, text } = Astro.props;
---

<section class="section-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="text">{text}</p>
</section>

<style>
  .section-hero { width: min(850px, calc(100% - 48px)); margin: 0 auto; padding: 105px 0 66px; text-align: left; }
  .eyebrow { margin: 0; color: var(--gold); font: 700 10px var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 18px 0 26px; color: var(--ink); font: 500 clamp(56px, 8vw, 98px)/.9 var(--display); letter-spacing: -.035em; }
  .text { max-width: 670px; margin: 0; font-size: 20px; line-height: 1.5; }
  @media (max-width: 650px) { .section-hero { width: min(100% - 32px, 850px); padding: 68px 0 48px; }.text { font-size: 18px; } }
</style>
