---
interface Props { eyebrow: string; title: string; text: string; }
const { eyebrow, title, text } = Astro.props;
---
<section class="section-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{text}</p>
</section>
<style>
  .section-hero { width: min(800px, calc(100% - 48px)); margin: 0 auto; padding: 95px 0 70px; text-align: center; }
  .eyebrow { color: var(--gold); font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 12px 0 20px; font-size: clamp(42px, 7vw, 76px); font-weight: 400; line-height: 1.03; }
  .section-hero > p:last-child { max-width: 600px; margin: auto; font-size: 21px; }
</style>
