---
interface Props { category: string; title: string; excerpt: string; }
const { category, title, excerpt } = Astro.props;
---

<article class="article-card">
  <p>{category}</p>
  <h2>{title}</h2>
  <div class="rule" aria-hidden="true"></div>
  <span>{excerpt}</span>
</article>

<style>
  .article-card { padding: 25px 0 30px; border-top: 1px solid var(--line); }
  p { margin: 0 0 38px; color: var(--terre); font: 700 10px var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  h2 { max-width: 430px; margin: 0; color: var(--ink); font: 500 37px/1 var(--display); letter-spacing: -.02em; }
  .rule { width: 42px; margin: 25px 0 16px; border-top: 1px solid var(--gold); }
  span { display: block; max-width: 440px; color: var(--sage); font: 400 17px/1.6 var(--serif); }
  @media (max-width: 650px) { h2 { font-size: 32px; } }
</style>
