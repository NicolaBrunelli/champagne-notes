---
interface Props { category: string; title: string; excerpt: string; }
const { category, title, excerpt } = Astro.props;
---
<article class="article-card">
  <p>{category}</p>
  <h2>{title}</h2>
  <div class="rule"></div>
  <span>{excerpt}</span>
</article>
<style>
  .article-card { border-top: 1px solid var(--ink); padding: 18px 0 25px; }
  p { margin: 0 0 34px; color: var(--sage); font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: 0; font-size: 29px; font-weight: 400; line-height: 1.16; }
  .rule { width: 32px; border-top: 1px solid var(--gold); margin: 22px 0 14px; }
  span { color: #566159; font-size: 16px; line-height: 1.45; }
</style>
