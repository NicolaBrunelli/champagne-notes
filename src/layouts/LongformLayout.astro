---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} · scritto e redatto da Brunelli Nicola`}>
  <article class="longform">
    <header class="longform-header">
      <p class="eyebrow">01 — Storia e metodo</p>
      <p class="byline">Scritto e redatto da Brunelli Nicola</p>
    </header>
    <slot />
  </article>
</BaseLayout>

<style>
  .longform { width: min(850px, calc(100% - 48px)); margin: auto; padding: 105px 0 10px; }
  .eyebrow, .byline { margin: 0; font: 700 10px var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  .eyebrow { color: var(--gold); }
  .byline { margin: 16px 0 54px; color: var(--sage); font-weight: 600; }
  .longform :global(h1) { margin: 0 0 30px; color: var(--ink); font: 500 clamp(56px, 8vw, 98px)/.9 var(--display); letter-spacing: -.035em; }
  .longform :global(h2) { margin: 88px 0 24px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--ink); font: 500 clamp(38px, 5vw, 58px)/.98 var(--display); letter-spacing: -.025em; }
  .longform :global(h3) { margin: 52px 0 14px; color: var(--ink); font: 500 32px/1 var(--display); }
  .longform :global(p), .longform :global(li) { max-width: 740px; font: 400 18px/1.7 var(--serif); }
  .longform :global(li) { margin: 9px 0; }
  .longform :global(ul), .longform :global(ol) { max-width: 740px; padding-left: 25px; }
  .longform :global(strong) { font-weight: 500; color: var(--ink); }
  .longform :global(blockquote) { max-width: 680px; margin: 46px auto; padding: 4px 0 4px 28px; border-left: 2px solid var(--gold); color: var(--terre); font: 400 clamp(27px, 4vw, 39px)/1.08 var(--display); }
  .longform :global(pre) { max-width: 740px; margin: 30px 0; padding: 20px 0; overflow: visible; border-block: 1px solid var(--line); color: var(--sage); background: transparent; white-space: pre-wrap; text-align: left; font: 600 12px/1.65 var(--sans); letter-spacing: .04em; }
  .longform :global(hr) { max-width: 740px; margin: 68px 0; border: 0; border-top: 1px solid var(--line); }
  @media (max-width: 650px) {
    .longform { width: min(100% - 32px, 850px); padding-top: 68px; }
    .byline { margin-bottom: 44px; }
    .longform :global(p), .longform :global(li) { font-size: 17px; }
    .longform :global(h2) { margin-top: 62px; }
    .longform :global(h3) { font-size: 29px; }
    .longform :global(pre) { font-size: 10px; }
  }
</style>
