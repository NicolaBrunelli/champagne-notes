---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Champagne — Appunti personali · scritto e redatto da Brunelli Nicola',
  description = 'Un archivio personale dedicato allo Champagne.',
} = Astro.props;
const path = Astro.url.pathname;
const navigation = [
  { href: '/storia-e-metodo', label: 'Storia e metodo' },
  { href: '/territorio', label: 'Territorio' },
  { href: '/cantine-e-vini', label: 'Cantine e vini' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Champagne, pagina iniziale">
          <span class="brand-mark">C</span>
          <span>Champagne</span>
        </a>
        <nav aria-label="Navigazione principale">
          <ul>
            {navigation.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="login-link" href="/accesso">Accesso riservato</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>Champagne — archivio personale</p>
      <a href="/accesso">Area riservata</a>
    </footer>
  </body>
</html>

<style is:global>
  :root { --ink: #1f2a24; --paper: #f8f6f0; --sage: #607164; --gold: #b28c48; --line: #dad5c7; --serif: Georgia, 'Times New Roman', serif; --sans: Arial, sans-serif; }
  * { box-sizing: border-box; }
  @-webkit-keyframes tracking-in-contract { 0% { opacity: 0; transform: translateY(8px); } 100% { opacity: 1; transform: translateY(0); } }
  @keyframes tracking-in-contract { 0% { opacity: 0; transform: translateY(8px); } 100% { opacity: 1; transform: translateY(0); } }
  body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--serif); font-size: 18px; line-height: 1.6; }
  main { -webkit-animation: tracking-in-contract .45s ease-out both; animation: tracking-in-contract .45s ease-out both; }
  @media (prefers-reduced-motion: reduce) { main { -webkit-animation: none; animation: none; } }
  a { color: inherit; text-decoration: none; }
  .site-header { border-bottom: 1px solid var(--line); }
  .header-inner, .site-footer { width: min(1180px, calc(100% - 48px)); margin: auto; }
  .header-inner { min-height: 88px; display: flex; align-items: center; gap: 34px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 22px; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .brand-mark { border: 1px solid var(--gold); border-radius: 50%; display: grid; place-items: center; width: 32px; height: 32px; color: var(--gold); font-size: 19px; }
  nav { margin-left: auto; } nav ul { display: flex; flex-wrap: wrap; gap: 22px; list-style: none; margin: 0; padding: 0; }
  nav a { font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; } nav a[aria-current='page'], nav a:hover { color: var(--gold); }
  .login-link { border: 1px solid var(--ink); padding: 8px 11px; font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .site-footer { border-top: 1px solid var(--line); display: flex; justify-content: space-between; padding: 25px 0 36px; margin-top: 80px; font-family: var(--sans); font-size: 12px; letter-spacing: .04em; }
  .site-footer p { margin: 0; }
  main #s1, main #s6, main .article > footer { display: none; }
  main .map { margin: 56px 0 0; } main .map img { display: block; width: 100%; max-width: 720px; margin: auto; border: 1px solid var(--line); } main .map figcaption { display: block; max-width: 720px; margin: 10px auto 0; color: var(--sage); font: 600 11px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 800px) { .header-inner { padding: 15px 0; flex-wrap: wrap; gap: 14px; } nav { order: 3; width: 100%; overflow:auto; } nav ul { width:max-content; gap:18px; } .login-link { margin-left: auto; min-height:38px; display:inline-flex; align-items:center; } }
  @media (max-width: 520px) { .header-inner, .site-footer { width: min(100% - 32px, 1180px); } .brand { font-size: 17px; }.brand-mark{width:29px;height:29px}.login-link{font-size:10px;padding:7px 9px}.site-footer { margin-top: 48px; gap:18px; } }
</style>
