---
import BaseLayout from '../layouts/BaseLayout.astro';
import { maisonAreas, maisons } from '../data/maisons';
---
<BaseLayout title="Cantine e vini — Champagne · scritto e redatto da Brunelli Nicola">
  <article class="directory">
    <header class="directory-header">
      <p>03 — Cantine e vini</p>
      <small>Scritto e redatto da Brunelli Nicola</small>
      <h1>Le cantine,<br />area per area.</h1>
      <div>Un archivio modulare di maison, vigneron e cooperative. Ogni cantina avrà una propria scheda; al suo interno verranno raccolti i vini.</div>
    </header>

    <div class="directory-nav" aria-label="Aree della Champagne">
      {maisonAreas.map((area) => <a href={'#' + area.toLowerCase().replaceAll(' ', '-').replaceAll('é','e')}>{area}</a>)}
    </div>

    {maisonAreas.map((area) => (
      <section id={area.toLowerCase().replaceAll(' ', '-').replaceAll('é','e')}>
        <p class="area-label">Maison</p>
        <h2>{area}</h2>
        <div class="maison-grid">
          {maisons.filter((maison) => maison.area === area).map((maison) => (
            <article class="maison-card">
              <div class="logo-frame">
                <img src={maison.logo} alt={'Logo ' + maison.name} width="258" height="258" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </div>
              <h3>{maison.name}</h3>
              <p>Scheda vini in arrivo</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .directory{width:min(850px,calc(100% - 48px));margin:auto}
  .directory-header{padding:95px 0 55px;text-align:left}
  .directory-header>p,.area-label{margin:0;color:var(--gold);font:700 12px var(--sans);letter-spacing:.13em;text-transform:uppercase}
  .directory-header small{display:block;margin:16px 0 55px;color:var(--sage);font:700 12px var(--sans);letter-spacing:.13em;text-transform:uppercase}
  .directory h1{font-size:clamp(50px,8vw,92px);font-weight:400;line-height:.94;margin:0 0 30px}
  .directory-header div{max-width:760px;font-size:18px}
  .directory-nav{display:flex;gap:15px;flex-wrap:wrap;padding:15px 0;border-block:1px solid var(--line)}
  .directory-nav a{font:600 11px var(--sans);letter-spacing:.08em;text-transform:uppercase}
  .directory-nav a:hover{color:var(--gold)}
  section{padding:68px 0;border-bottom:1px solid var(--line)}
  h2{font-size:clamp(34px,5vw,55px);font-weight:400;line-height:1.04;margin:10px 0 32px}
  .maison-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
  .maison-card{min-width:0;background:var(--paper);padding:18px;display:flex;flex-direction:column}
  .logo-frame{aspect-ratio:1;display:grid;place-items:center;background:#fff}
  .logo-frame img{display:block;width:100%;height:100%;object-fit:contain}
  .maison-card h3{font-size:20px;font-weight:400;line-height:1.15;margin:17px 0 6px}
  .maison-card p{margin:0;color:var(--sage);font:600 10px var(--sans);letter-spacing:.07em;text-transform:uppercase}
  @media(max-width:700px){.directory{width:min(100% - 32px,850px)}.directory-header{padding:65px 0 42px}.directory-header div{font-size:17px}.directory-nav{overflow:auto;flex-wrap:nowrap;white-space:nowrap}.directory-nav a{padding:2px 0}section{padding:52px 0}.maison-grid{grid-template-columns:repeat(2,1fr)}.maison-card{padding:12px}.maison-card h3{font-size:17px;margin-top:12px}.maison-card p{font-size:9px}}
</style>

