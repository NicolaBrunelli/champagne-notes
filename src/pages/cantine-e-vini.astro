---
import BaseLayout from '../layouts/BaseLayout.astro';
import { maisonAreas, maisons } from '../data/maisons';
const areaId = (area: string) => area.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replaceAll(' ', '-');
const areaDescription: Record<string, string> = {
  'Côte des Blancs': 'Chardonnay, craie e precisione: una costellazione di vigneron e maison radicati nel calcare.',
  'Vallée de la Marne': 'Meunier, Pinot Noir e paesaggi mossi dal fiume: l’archivio della valle occidentale.',
  'Montagne de Reims': 'La dorsale dei grandi Pinot Noir, tra versanti esposti, foreste e villaggi storici.',
  'Côte des Bar': 'L’Aube, le argille kimmeridgiane e una Champagne dalla voce più meridionale.',
};
---

<BaseLayout title="Cantine e vini — Lo Champagne, con calma">
  <article class="directory">
    <header class="directory-header">
      <p class="eyebrow">03 — Cantine e vini</p>
      <p class="byline">Scritto e redatto da Brunelli Nicola</p>
      <h1>Le cantine,<br /><em>area per area.</em></h1>
      <div>Un archivio modulare di maison, vigneron e cooperative. Ogni cantina avrà una propria scheda; al suo interno verranno raccolti i vini.</div>
    </header>

    <nav class="directory-nav" aria-label="Aree della Champagne">
      {maisonAreas.map((area, index) => <a href={'#' + areaId(area)}><span>0{index + 1}</span>{area}</a>)}
    </nav>

    {maisonAreas.map((area, index) => (
      <section id={areaId(area)}>
        <header class="area-header">
          <p>Area {String(index + 1).padStart(2, '0')}</p>
          <h2>{area}</h2>
          <div><span>{maisons.filter((maison) => maison.area === area).length} cantine</span><p>{areaDescription[area]}</p></div>
        </header>
        <div class="maison-grid">
          {maisons.filter((maison) => maison.area === area).map((maison) => (
            <article class="maison-card">
              <div class="logo-frame">
                <img src={maison.logo} alt={'Logo ' + maison.name} width="258" height="258" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </div>
              <h3>{maison.name}</h3>
              <p>Scheda vini in arrivo <span aria-hidden="true">↗</span></p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .directory { width: min(850px, calc(100% - 48px)); margin: auto; }
  .directory-header { padding: 105px 0 54px; text-align: left; }
  .eyebrow, .byline, .area-header > p { margin: 0; font: 700 10px var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  .eyebrow, .area-header > p { color: var(--gold); }
  .byline { margin: 16px 0 54px; color: var(--sage); font-weight: 600; }
  .directory h1 { margin: 0 0 28px; color: var(--ink); font: 500 clamp(56px, 8vw, 98px)/.9 var(--display); letter-spacing: -.035em; }
  .directory h1 em { color: var(--terre); font-weight: 400; }
  .directory-header > div { max-width: 700px; font-size: 20px; line-height: 1.48; }
  .directory-nav { display: flex; gap: 16px 24px; flex-wrap: wrap; padding: 16px 0; border-block: 1px solid var(--line); }
  .directory-nav a { display: flex; gap: 8px; align-items: baseline; color: var(--ink); font: 600 10px var(--sans); letter-spacing: .09em; text-transform: uppercase; transition: color .25s ease; }
  .directory-nav a span { color: var(--gold); font-size: 9px; }
  .directory-nav a:hover { color: var(--terre); }
  section { padding: 76px 0; border-bottom: 1px solid var(--line); }
  .area-header { margin-bottom: 34px; }
  h2 { margin: 12px 0 16px; color: var(--ink); font: 500 clamp(40px, 5vw, 60px)/.96 var(--display); letter-spacing: -.025em; }
  .area-header > div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 20px; max-width: 690px; color: var(--sage); }
  .area-header span { color: var(--terre); font: 600 10px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .area-header div p { margin: 0; font-size: 17px; line-height: 1.55; }
  .maison-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border: 1px solid var(--line); background: var(--line); }
  .maison-card { min-width: 0; display: flex; flex-direction: column; padding: 17px; background: rgba(255,255,255,.3); transition: background .3s ease, transform .3s ease; }
  .maison-card:hover { z-index: 1; background: rgba(255,255,255,.72); transform: translateY(-3px); }
  .logo-frame { aspect-ratio: 1; display: grid; place-items: center; padding: 8px; background: rgba(255,255,255,.72); border-bottom: 1px solid var(--line); }
  .logo-frame img { display: block; width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; filter: saturate(.76) contrast(.98); transition: filter .35s ease; }
  .maison-card:hover img { filter: saturate(1) contrast(1); }
  .maison-card h3 { margin: 17px 0 9px; color: var(--ink); font: 500 25px/1 var(--display); letter-spacing: -.015em; }
  .maison-card > p { margin: auto 0 0; color: var(--sage); font: 600 9px var(--sans); letter-spacing: .075em; text-transform: uppercase; }
  .maison-card > p span { color: var(--gold); font-size: 13px; }
  @media (max-width: 700px) {
    .directory { width: min(100% - 32px, 850px); }
    .directory-header { padding: 68px 0 44px; }
    .byline { margin-bottom: 44px; }
    .directory-header > div { font-size: 18px; }
    .directory-nav { flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
    .directory-nav::-webkit-scrollbar { display: none; }
    section { padding: 58px 0; }
    .area-header > div { grid-template-columns: 1fr; gap: 9px; }
    .maison-grid { grid-template-columns: repeat(2, 1fr); }
    .maison-card { padding: 12px; }
    .maison-card h3 { margin-top: 13px; font-size: 21px; }
  }
</style>
