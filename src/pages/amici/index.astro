---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Amici — Lo Champagne, con calma">
  <section class="friends" data-friends-page>
    <p class="eyebrow">Archivio condiviso</p>
    <h1>Gli<br /><em>amici.</em></h1>
    <p class="intro">I taccuini delle persone invitate nell’archivio: bottiglie bevute, voti e cantine personali.</p>
    <div class="friend-grid" data-friend-grid aria-live="polite"><p>Caricamento degli amici…</p></div>
  </section>
</BaseLayout>

<script>
  import { getUser } from '@netlify/identity';
  type Friend = { handle: string; avatar: boolean; tastingCount: number; cellarCount: number };
  const grid = document.querySelector<HTMLElement>('[data-friend-grid]');
  const escapeHTML = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character] || character));
  const draw = (friends: Friend[]) => {
    if (!grid) return;
    if (!friends.length) { grid.innerHTML = '<p class="empty">Non ci sono ancora taccuini da esplorare.</p>'; return; }
    grid.innerHTML = friends.map((friend) => `<a class="friend-card" href="/amici/profilo?utente=${encodeURIComponent(friend.handle)}">
      <span class="friend-avatar">${friend.avatar ? `<img src="/api/profilo/avatar?utente=${encodeURIComponent(friend.handle)}" alt="Foto profilo di ${escapeHTML(friend.handle)}">` : escapeHTML(friend.handle.slice(0, 1).toUpperCase())}</span>
      <span class="friend-handle">${escapeHTML(friend.handle)}</span>
      <span class="friend-meta">${friend.tastingCount} ${friend.tastingCount === 1 ? 'bevuta' : 'bevute'} · ${friend.cellarCount} in cantina</span>
      <span class="friend-arrow" aria-hidden="true">→</span>
    </a>`).join('');
  };
  void getUser().then(async (user) => {
    if (!user) { window.location.href = '/accesso'; return; }
    const response = await fetch('/api/amici', { headers: { Accept: 'application/json' } });
    if (!response.ok) throw new Error();
    draw((await response.json() as { friends: Friend[] }).friends);
  }).catch(() => { if (grid) grid.innerHTML = '<p class="empty">Non è stato possibile caricare gli amici. Riprova tra poco.</p>'; });
</script>

<style>
  .friends { width: min(950px, calc(100% - 48px)); margin: auto; padding: 112px 0 70px; }
  .eyebrow { margin: 0; color: var(--gold); font: 700 10px var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 22px 0 24px; font: 500 clamp(56px, 8vw, 86px)/.87 var(--display); letter-spacing: -.04em; } h1 em { color: var(--terre); font-weight: 400; }
  .intro { max-width: 570px; margin: 0; color: var(--sage); font-size: 19px; line-height: 1.55; }
  .friend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 48px; }
  :global(.friend-card) { position: relative; display: grid; gap: 9px; min-height: 210px; padding: 24px; border: 1px solid var(--line); background: rgba(255,255,255,.22); transition: transform .25s ease, background .25s ease, border-color .25s ease; }
  :global(.friend-card:hover) { border-color: var(--gold); background: rgba(255,255,255,.5); transform: translateY(-3px); }
  :global(.friend-avatar) { display: grid; place-items: center; width: 52px; height: 52px; overflow: hidden; border: 1px solid var(--gold); border-radius: 50%; color: var(--gold); font: 500 28px/1 var(--display); }
  :global(.friend-avatar img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.friend-handle) { font: 500 31px/1 var(--display); }
  :global(.friend-meta) { align-self: end; color: var(--sage); font: 600 9px var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  :global(.friend-arrow) { position: absolute; top: 25px; right: 23px; color: var(--terre); }
  :global(.empty) { color: var(--sage); }
  @media (max-width: 720px) { .friends { width: min(100% - 32px, 950px); padding-top: 74px; } .friend-grid { grid-template-columns: 1fr; } :global(.friend-card) { min-height: 170px; } }
</style>
