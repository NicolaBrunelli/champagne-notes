---
import BaseLayout from '../layouts/BaseLayout.astro';
import { maisons } from '../data/maisons';
---

<BaseLayout title="My Champagne — Champagne Vademecum">
  <section class="passport-shell" data-account-page data-passport-shell>
    <header class="passport-intro">
      <p class="eyebrow">My Champagne</p>
      <h1>Il tuo viaggio<br /><em>nello Champagne.</em></h1>
      <p>Il tuo taccuino diventa un passaporto: bottiglie, luoghi e scoperte da sfogliare con calma.</p>
    </header>

    <div class="passport-tabs" aria-label="Indice del Champagne Passport" role="navigation">
      <button type="button" data-passport-go="1"><b>01–02</b> Overview</button>
      <button type="button" data-passport-go="3"><b>03–04</b> Degustazioni</button>
      <button type="button" data-passport-go="5"><b>05–06</b> Cantina</button>
      <button type="button" data-passport-go="7"><b>07–08</b> Wishlist</button>
      <button type="button" data-passport-go="9"><b>09–10</b> Le tracce</button>
      <button type="button" data-passport-go="11"><b>11–12</b> Il mio gusto</button>
      <button type="button" data-passport-go="13"><b>13–14</b> Profilo</button>
    </div>

    <div class="passport-stage" data-passport-stage>
      <div class="passport-book" data-passport-book>
        <section class="passport-cover" data-passport-page="0" data-passport-cover role="button" tabindex="0" aria-label="Apri il Champagne Passport">
          <div class="cover-grain" aria-hidden="true"></div>
          <div class="cover-border" aria-hidden="true"></div>
          <p>Brunelli Nicola</p>
          <div class="cover-mark" aria-hidden="true"><span>C</span><i></i><i></i><i></i></div>
          <h2>Champagne<br /><em>Passport</em></h2>
          <small>Le voyage en Champagne</small>
          <button type="button" data-passport-open>Apri il passaporto <span aria-hidden="true">→</span></button>
        </section>

        <section class="passport-page identity-page" data-passport-page="1" id="intro" aria-labelledby="passport-identity-title" hidden>
          <div class="passport-page-head"><span>01 — Overview</span><span data-passport-number>CH-000000</span></div>
          <div class="identity-grid">
            <span class="passport-avatar"><img data-avatar-image alt="Foto profilo" hidden /><b data-avatar-fallback>?</b></span>
            <div><p class="passport-label">Champagne Passport</p><h2 id="passport-identity-title" data-passport-handle>Il tuo nome</h2><em data-passport-signature>Il tuo viaggio</em></div>
          </div>
          <dl class="identity-data"><div><dt>Membro dal</dt><dd data-passport-since>—</dd></div><div><dt>Passaporto</dt><dd data-passport-number>CH-000000</dd></div><div><dt>Destinazione</dt><dd>Champagne, France</dd></div></dl>
          <div class="passport-watermark" aria-hidden="true">CHAMPAGNE · CRAIE · VIGNE · MÉMOIRE</div>
          <div class="passport-page-foot"><span>My Champagne Passport</span><b>01</b></div>
        </section>

        <section id="overview" class="passport-page overview continuation-page" data-passport-page="2" aria-labelledby="overview-title" hidden>
          <div class="passport-page-head"><span>02 — Overview</span><span>Journal de bord</span></div>
      <div class="section-heading"><h2 id="overview-title">Overview</h2></div>
      <div class="stats" data-overview-stats><p class="loading">Sto aprendo il tuo taccuino…</p></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>02</b></div>
        </section>

        <section id="degustazioni" class="passport-page account-section" data-passport-page="3" aria-labelledby="tastings-title" hidden>
          <div class="passport-page-head"><span>03 — Degustazioni</span><span>Entrées</span></div>
      <div class="section-heading"><h2 id="tastings-title">Degustazioni</h2></div>
      <p class="intro">Le bottiglie bevute restano una storia separata dal semplice possesso. Ogni pagina di cantina permette di aggiungerne una nuova.</p>
      <p class="status" data-tasting-status aria-live="polite"></p>
      <div data-my-tastings aria-live="polite"><p class="loading">Caricamento delle degustazioni…</p></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>03</b></div>
        </section>

        <section class="passport-page account-section continuation-page" data-passport-page="4" aria-label="Degustazioni, seconda pagina" hidden>
          <div class="passport-page-head"><span>04 — Degustazioni</span><span>Entrées · suite</span></div>
          <div class="section-heading"><h2>Degustazioni</h2></div>
          <div data-my-tastings-secondary aria-live="polite"><p class="loading">Caricamento delle degustazioni…</p></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>04</b></div>
        </section>

        <section id="cantina" class="passport-page account-section" data-passport-page="5" aria-labelledby="cellar-title" hidden>
          <div class="passport-page-head"><span>05 — Cantina</span><span>Registre de cave</span></div>
      <div class="section-heading"><h2 id="cellar-title">Cantina</h2></div>
      <p class="intro">Le bottiglie che possiedi, senza confonderle con ciò che hai già degustato.</p>
      <div class="passport-note">Qui custodisci le bottiglie che possiedi. La loro storia resta distinta dalle degustazioni: quando ne aprirai una, potrai annotarla nel taccuino senza perderne traccia.</div>
      <div class="collection" data-cellar-collection aria-live="polite"><p class="loading">Caricamento della cantina…</p></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>05</b></div>
        </section>

        <section class="passport-page account-section continuation-page" data-passport-page="6" aria-label="Cantina, seconda pagina" hidden>
          <div class="passport-page-head"><span>06 — Cantina</span><span>Inventaire</span></div>
          <div class="section-heading"><h2>Cantina</h2></div>
          <form class="record-form" data-cellar-form>
            <label>Produttore<input name="producer" list="maison-options" required placeholder="Es. Jacques Selosse" /></label>
            <label>Champagne<input name="wine" required placeholder="Es. Substance" /></label>
            <label>Annata <input name="vintage" inputmode="numeric" maxlength="12" placeholder="Es. 2014" /></label>
            <label>Quantità <input name="quantity" type="number" min="1" max="99" value="1" required /></label>
            <button type="submit">Aggiungi in cantina <span aria-hidden="true">→</span></button><p class="status" data-cellar-status aria-live="polite"></p>
          </form>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>06</b></div>
        </section>

        <section id="wishlist" class="passport-page account-section" data-passport-page="7" aria-labelledby="wishlist-title" hidden>
          <div class="passport-page-head"><span>07 — Wishlist</span><span>Prochaines découvertes</span></div>
      <div class="section-heading"><h2 id="wishlist-title">Wishlist</h2></div>
      <p class="intro">Una lista essenziale di Champagne che vuoi provare o acquistare. Puoi aggiungere una cuvée dalle pagine dei produttori oppure annotarla qui.</p>
      <div class="passport-note">Una lista di indirizzi da seguire: Champagne da provare, acquistare o ritrovare quando sarà il momento giusto.</div>
      <div class="collection wishlist-collection" data-wishlist-collection aria-live="polite"><p class="loading">Caricamento della wishlist…</p></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>07</b></div>
        </section>

        <section class="passport-page account-section continuation-page" data-passport-page="8" aria-label="Wishlist, seconda pagina" hidden>
          <div class="passport-page-head"><span>08 — Wishlist</span><span>À découvrir</span></div>
          <div class="section-heading"><h2>Wishlist</h2></div>
          <form class="record-form" data-wishlist-form>
            <label>Produttore<input name="producer" list="maison-options" required placeholder="Es. Bollinger" /></label>
            <label>Champagne<input name="wine" required placeholder="Es. La Grande Année" /></label>
            <button type="submit">Aggiungi alla wishlist <span aria-hidden="true">→</span></button><p class="status" data-wishlist-status aria-live="polite"></p>
          </form>
          <datalist id="maison-options">{maisons.map((maison) => <option value={maison.name} />)}</datalist>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>08</b></div>
        </section>

        <section class="passport-page account-section stamps-page" data-passport-page="9" aria-labelledby="stamps-title" hidden>
          <div class="passport-page-head"><span>09 — Le tracce</span><span>Visa de voyage</span></div>
          <div class="stamps-intro"><h2 id="stamps-title">Le tracce<br />del tuo viaggio.</h2><p>Ogni bottiglia lascia una traccia. Alcune meritano un timbro.</p></div>
          <div class="stamps-canvas" data-passport-stamps aria-live="polite"></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>09</b></div>
        </section>

        <section class="passport-page account-section continuation-page stamps-page" data-passport-page="10" aria-label="Le tracce del tuo viaggio, seconda pagina" hidden>
          <div class="passport-page-head"><span>10 — Le tracce</span><span>Visa de voyage · suite</span></div>
          <div class="stamps-canvas stamps-canvas--secondary" data-passport-stamps-secondary aria-live="polite"></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>10</b></div>
        </section>

        <section id="gusto" class="passport-page account-section taste" data-passport-page="11" aria-labelledby="taste-title" hidden>
          <div class="passport-page-head"><span>11 — Il mio gusto</span><span>Profil de goût</span></div>
          <div class="section-heading"><h2 id="taste-title">Il mio gusto</h2></div>
          <div data-taste-profile><p class="loading">Sto leggendo le tracce del tuo percorso…</p></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>11</b></div>
        </section>

        <section class="passport-page account-section continuation-page" data-passport-page="12" aria-label="Il mio gusto, seconda pagina" hidden>
          <div class="passport-page-head"><span>12 — Il mio gusto</span><span>Continua a scoprire</span></div>
          <div class="section-heading"><h2>Il mio gusto</h2></div>
          <div data-suggestions><p class="empty">Registra una prima bottiglia: da lì potremo suggerire un prossimo confronto con un perché chiaro.</p></div>
          <div data-taste-profile-secondary></div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>12</b></div>
        </section>

        <aside class="passport-page account-panel" data-passport-page="13" id="profilo" aria-label="Profilo personale" hidden>
          <div class="passport-page-head"><span>13 — Impostazioni</span><span>Votre sceau</span></div>
      <p class="label">Personalizza il passaporto</p>
      <div class="avatar-editor"><span class="account-avatar"><img data-profile-avatar-image alt="Foto profilo" hidden /><b data-profile-avatar-fallback>?</b></span><label>Foto profilo <input data-avatar-file type="file" accept="image/jpeg,image/png,image/webp" /><span>JPG, PNG o WebP · max 2 MB</span></label><button type="button" class="outline-button" data-avatar-save>Salva foto</button></div>
      <p class="status" data-avatar-status aria-live="polite"></p>
      <form class="handle-editor" data-handle-form>
        <label>Username<input name="handle" data-handle-input required minlength="3" maxlength="32" pattern="[A-Za-z0-9._-]+" autocomplete="username" /></label>
        <p>È il nome che appare nel tuo passaporto e nella raccolta Amici.</p>
        <button type="submit" class="outline-button">Aggiorna username</button>
        <span class="status" data-handle-status aria-live="polite"></span>
      </form>
      <a class="admin-link" href="/amici#inviti" data-admin-link hidden>Inviti e codici <span aria-hidden="true">→</span></a><button type="button" class="logout" data-logout>Esci dal tuo passaporto</button>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>13</b></div>
        </aside>
        <section class="passport-page account-section continuation-page" data-passport-page="14" aria-label="Profilo, seconda pagina" hidden>
          <div class="passport-page-head"><span>14 — Il tuo archivio</span><span>À conserver</span></div>
          <div class="passport-note">Ogni valutazione, bottiglia e appunto resta nel tuo archivio personale: un passaporto che prende forma pagina dopo pagina.</div>
          <div class="passport-page-foot"><span>Champagne Passport</span><b>14</b></div>
        </section>
      </div>
      <dialog class="tasting-editor" data-tasting-editor aria-labelledby="tasting-editor-title">
        <form data-tasting-editor-form>
          <div class="tasting-editor-head"><p>Modifica degustazione</p><button type="button" data-tasting-editor-close aria-label="Chiudi">×</button></div>
          <h2 id="tasting-editor-title">Il taccuino.</h2>
          <p class="tasting-editor-producer" data-tasting-editor-producer></p>
          <div class="tasting-editor-fields">
            <label>Champagne<input name="wine" required maxlength="160" /></label>
            <label>Data<input name="drunkAt" type="date" required /></label>
            <label>Luogo<input name="place" required maxlength="160" /></label>
            <label>Prezzo <input name="price" type="number" min="0" step="0.01" inputmode="decimal" /></label>
            <label>Voto<select name="rating" required><option value="0.5">0,5 / 5</option><option value="1">1 / 5</option><option value="1.5">1,5 / 5</option><option value="2">2 / 5</option><option value="2.5">2,5 / 5</option><option value="3">3 / 5</option><option value="3.5">3,5 / 5</option><option value="4">4 / 5</option><option value="4.5">4,5 / 5</option><option value="5">5 / 5</option></select></label>
            <label>Lo ricompreresti?<select name="wouldRepurchase"><option value="">Non indicato</option><option value="yes">Sì</option><option value="no">No</option></select></label>
          </div>
          <label class="tasting-editor-notes">Note personali<textarea name="notes" rows="4" maxlength="3000"></textarea></label>
          <p class="status" data-tasting-editor-status aria-live="polite"></p>
          <div class="tasting-editor-actions"><button type="button" class="outline-button" data-tasting-editor-close>Annulla</button><button type="submit">Salva modifica <span aria-hidden="true">→</span></button></div>
        </form>
      </dialog>
      <dialog class="stamp-detail" data-stamp-detail aria-labelledby="stamp-detail-title">
        <div><button type="button" data-stamp-detail-close aria-label="Chiudi">×</button><p>Nouveau timbre</p><h2 id="stamp-detail-title" data-stamp-detail-title></h2><span class="stamp-detail-mark" data-stamp-detail-mark></span><blockquote data-stamp-detail-message></blockquote><small data-stamp-detail-date></small></div>
      </dialog>
      <div class="passport-controls" aria-label="Sfoglia il passaporto"><button type="button" data-passport-prev aria-label="Pagina precedente">←</button><span data-passport-position>Copertina</span><button type="button" data-passport-next aria-label="Pagina successiva">→</button></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { logout, updateUser } from '@netlify/identity';
  import { aromas } from '../data/aromas';
  import { getCurrentUser } from '../scripts/identity-session';

  type SensoryProfile = { body: number; tannin: number; sweetness: number; acidity: number };
  type ExperienceProfile = { maturity: number; structure: number; tension: number; complexity: number };
  type PassportStamp = { id: string; name: string; message: string; stampVariant: number; stampShape: string; stampSize: string; rotation: number; visualMotif: string; position: { x: number; y: number; mobileX: number; mobileY: number }; unlockedAt: string; isNew: boolean };
  type Tasting = { id: string; wine: string; drunkAt: string; place: string; price?: number; rating: number; notes?: string; aromas?: string[]; sensory?: SensoryProfile; experience?: ExperienceProfile; wouldRepurchase?: boolean; producer: { slug: string; name: string } };
  type Bottle = { id: string; producer: string; wine: string; vintage?: string; quantity: number };
  type Wish = { id: string; producer: string; producerSlug?: string; wine: string };
  type Atlas = { tastings: Tasting[]; cellar: Bottle[]; wishlist: Wish[]; stamps: PassportStamp[]; overview: { tasted: number; cellarBottles: number; wishlist: number; producers: number; areas: number; crus: number }; profile: { enough: boolean; sampleSize: number; styles: { favorite?: string; covered: number }; grapes: { favorite?: string; covered: number }; dosage: { favorite?: string; covered: number }; producers: { producer: string; rating: number }[]; territory: { areas: string[]; crus: string[] }; repurchase?: { yes: number; total: number; percent: number }; experience?: { count: number; description: string[] } }; suggestions: { title: string; reason: string; producer?: string; wine?: string }[] };
  const qs = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const tastingList = qs<HTMLElement>('[data-my-tastings]'); const tastingListSecondary = qs<HTMLElement>('[data-my-tastings-secondary]'); const cellarList = qs<HTMLElement>('[data-cellar-collection]'); const wishlistList = qs<HTMLElement>('[data-wishlist-collection]');
  const overview = qs<HTMLElement>('[data-overview-stats]'); const profileBox = qs<HTMLElement>('[data-taste-profile]'); const profileBoxSecondary = qs<HTMLElement>('[data-taste-profile-secondary]'); const suggestions = Array.from(document.querySelectorAll<HTMLElement>('[data-suggestions]'));
  const tastingStatus = qs<HTMLElement>('[data-tasting-status]'); const cellarStatus = qs<HTMLElement>('[data-cellar-status]'); const wishlistStatus = qs<HTMLElement>('[data-wishlist-status]');
  const stampsCanvas = qs<HTMLElement>('[data-passport-stamps]'); const stampsCanvasSecondary = qs<HTMLElement>('[data-passport-stamps-secondary]');
  const tastingEditor = qs<HTMLDialogElement>('[data-tasting-editor]'); const tastingEditorForm = qs<HTMLFormElement>('[data-tasting-editor-form]'); const tastingEditorStatus = qs<HTMLElement>('[data-tasting-editor-status]'); const tastingEditorProducer = qs<HTMLElement>('[data-tasting-editor-producer]');
  const stampDetail = qs<HTMLDialogElement>('[data-stamp-detail]'); const stampDetailTitle = qs<HTMLElement>('[data-stamp-detail-title]'); const stampDetailMark = qs<HTMLElement>('[data-stamp-detail-mark]'); const stampDetailMessage = qs<HTMLElement>('[data-stamp-detail-message]'); const stampDetailDate = qs<HTMLElement>('[data-stamp-detail-date]');
  const passportPages = Array.from(document.querySelectorAll<HTMLElement>('[data-passport-page]'));
  const passportTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-passport-go]'));
  const passportPosition = qs<HTMLElement>('[data-passport-position]');
  const passportStage = qs<HTMLElement>('[data-passport-stage]');
  const passportBook = qs<HTMLElement>('[data-passport-book]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let passportPage = 0;
  let lastPassportTurn = 0;
  let editingTasting: Tasting | undefined;
  const personalTastings = new Map<string, Tasting>();
  const passportStamps = new Map<string, PassportStamp>();
  const pageNames = ['Copertina', 'Overview', 'Overview', 'Degustazioni', 'Degustazioni', 'Cantina', 'Cantina', 'Wishlist', 'Wishlist', 'Le tracce', 'Le tracce', 'Il mio gusto', 'Il mio gusto', 'Profilo', 'Profilo'];
  const mobilePassport = () => window.matchMedia('(max-width: 760px)').matches;
  const clampPage = (value: number) => Math.max(0, Math.min(passportPages.length - 1, value));
  const animateLeaf = (from: number, direction: number) => {
    if (!passportBook || prefersReducedMotion.matches || from === 0) return;
    const leaf = document.createElement('div');
    leaf.setAttribute('aria-hidden', 'true');
    leaf.classList.add('passport-turn-leaf', direction > 0 ? 'turn-forward' : 'turn-back');
    passportBook.append(leaf);
    requestAnimationFrame(() => leaf.classList.add('is-flipping'));
    window.setTimeout(() => leaf.remove(), 680);
  };
  const renderPassport = (next: number, direction = 1, animate = true) => {
    const previous = passportPage;
    const requested = clampPage(next);
    passportPage = requested === 0 || mobilePassport() ? requested : requested - ((requested - 1) % 2);
    const visible = new Set<number>(passportPage === 0 || mobilePassport() ? [passportPage] : [passportPage, passportPage + 1].filter((index) => index < passportPages.length));
    if (animate && previous !== passportPage) animateLeaf(previous, direction);
    passportPages.forEach((page, index) => {
      const shouldShow = visible.has(index);
      page.hidden = !shouldShow;
      page.setAttribute('aria-hidden', String(!shouldShow));
      page.classList.remove('is-turning-forward', 'is-turning-back');
    });
    passportBook?.classList.toggle('is-closed', passportPage === 0);
    passportTabs.forEach((tab) => tab.setAttribute('aria-current', String(visible.has(Number(tab.dataset.passportGo)))));
    if (passportPosition) passportPosition.textContent = passportPage === 0 ? 'Copertina' : mobilePassport() ? `${String(passportPage).padStart(2, '0')} · ${pageNames[passportPage]}` : `${String(passportPage).padStart(2, '0')}–${String(Math.min(passportPage + 1, 14)).padStart(2, '0')} · ${pageNames[passportPage]}`;
  };
  const turnPassport = (direction: number) => {
    const step = mobilePassport() ? 1 : 2;
    if (passportPage === 0 && direction < 0) return;
    renderPassport(passportPage === 0 ? 1 : passportPage + (direction * step), direction);
  };
  const activatePassport = () => {
    renderPassport(0, 1, false);
    qs<HTMLButtonElement>('[data-passport-open]')?.addEventListener('click', () => renderPassport(1));
    const openCover = () => renderPassport(1);
    const cover = qs<HTMLElement>('[data-passport-cover]');
    cover?.addEventListener('click', openCover);
    cover?.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openCover(); } });
    qs<HTMLButtonElement>('[data-passport-prev]')?.addEventListener('click', () => turnPassport(-1));
    qs<HTMLButtonElement>('[data-passport-next]')?.addEventListener('click', () => turnPassport(1));
    passportTabs.forEach((tab) => tab.addEventListener('click', () => renderPassport(Number(tab.dataset.passportGo))));
    window.addEventListener('resize', () => renderPassport(passportPage, 1, false));
    document.addEventListener('keydown', (event) => {
      if ((event.target as HTMLElement | null)?.matches('input, textarea, select')) return;
      if (event.key === 'ArrowRight') turnPassport(1);
      if (event.key === 'ArrowLeft') turnPassport(-1);
    });
    passportStage?.addEventListener('wheel', (event) => {
      if (mobilePassport() || Math.abs(event.deltaY) < 18 || Date.now() - lastPassportTurn < 620) return;
      const page = passportPages[passportPage];
      const scrolling = page && getComputedStyle(page).overflowY !== 'hidden' && page.scrollHeight > page.clientHeight + 4;
      const atTop = !page || page.scrollTop <= 1;
      const atBottom = !page || page.scrollTop + page.clientHeight >= page.scrollHeight - 1;
      if (scrolling && !((event.deltaY > 0 && atBottom) || (event.deltaY < 0 && atTop))) return;
      if (passportPage === 0 || (event.deltaY > 0 && passportPage < passportPages.length - 1) || (event.deltaY < 0 && passportPage > 0)) {
        event.preventDefault(); lastPassportTurn = Date.now(); turnPassport(event.deltaY > 0 ? 1 : -1);
      }
    }, { passive: false });
    let touchStart: { x: number; y: number } | undefined;
    passportStage?.addEventListener('touchstart', (event) => { const touch = event.changedTouches[0]; touchStart = { x: touch.clientX, y: touch.clientY }; }, { passive: true });
    passportStage?.addEventListener('touchend', (event) => { const touch = event.changedTouches[0]; if (!touchStart) return; const x = touch.clientX - touchStart.x; const y = touch.clientY - touchStart.y; touchStart = undefined; if (Math.abs(x) > 56 && Math.abs(x) > Math.abs(y) * 1.4) turnPassport(x < 0 ? 1 : -1); }, { passive: true });
  };
  activatePassport();
