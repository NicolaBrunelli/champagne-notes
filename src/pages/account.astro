    if (tastingListSecondary) tastingListSecondary.innerHTML = data.tastings.slice(4, 8).length ? data.tastings.slice(4, 8).map(renderTasting).join('') : '<p class="empty">Le prossime degustazioni compariranno qui.</p>';
