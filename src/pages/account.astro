    stampDetail?.showModal();
    if (stamp.isNew) { void fetch('/api/my-champagne', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ seenAchievementIds: [id] }) }); button.classList.remove('is-new'); button.querySelector('small')?.remove(); }
  }));
  qs<HTMLButtonElement>('[data-stamp-detail-close]')?.addEventListener('click', () => stampDetail?.close());
  qs<HTMLButtonElement>('[data-avatar-save]')?.addEventListener('click', async () => { const file = qs<HTMLInputElement>('[data-avatar-file]')?.files?.[0]; const status = qs<HTMLElement>('[data-avatar-status]'); if (!file || !status) return; if (file.size > 2 * 1024 * 1024) { status.textContent = 'La foto supera il limite di 2 MB.'; return; } status.textContent = 'Salvataggio foto…'; try { const response = await fetch('/api/profilo/avatar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ photo: await readPhoto(file) }) }); if (!response.ok) throw new Error(); document.querySelectorAll<HTMLImageElement>('[data-avatar-image], [data-profile-avatar-image]').forEach((avatar) => { avatar.src = `/api/profilo/avatar?aggiornata=${Date.now()}`; avatar.hidden = false; }); document.querySelectorAll<HTMLElement>('[data-avatar-fallback], [data-profile-avatar-fallback]').forEach((fallback) => fallback.hidden = true); status.textContent = 'Foto profilo aggiornata.'; } catch { status.textContent = 'Non è stato possibile salvare la foto.'; } });
