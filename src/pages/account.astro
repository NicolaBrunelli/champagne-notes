    (tastingEditorForm.elements.namedItem('wouldRepurchase') as HTMLSelectElement).value = item.wouldRepurchase === true ? 'yes' : item.wouldRepurchase === false ? 'no' : '';
    (tastingEditorForm.elements.namedItem('notes') as HTMLTextAreaElement).value = item.notes || '';
