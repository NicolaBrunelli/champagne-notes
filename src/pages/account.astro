---
import BaseLayout from '../layouts/BaseLayout.astro';
import { maisons } from '../data/maisons';
---

<BaseLayout title="Il tuo account — Lo Champagne, con calma">
  <section class="account" data-account-page>
    <p class="eyebrow">Area personale</p>
    <h1>Il tuo<br /><em>taccuino.</em></h1>
    <p class="intro">Qui ritroverai le degustazioni che hai inserito e il tuo profilo nell’archivio condiviso.</p>

    <div class="account-panel">
      <p class="label">Utente</p>
      <div class="avatar-editor">
        <span class="account-avatar" data-account-avatar><img data-avatar-image alt="Foto profilo" hidden /><b data-avatar-fallback>?</b></span>
        <label>Foto profilo <input data-avatar-file type="file" accept="image/jpeg,image/png,image/webp" /><span>JPG, PNG o WebP · max 2 MB</span></label>
        <button type="button" class="outline-button" data-avatar-save>Salva foto</button>
        <p data-avatar-status aria-live="polite"></p>
      </div>
      <p class="name" data-user-name>Caricamento profilo…</p>
      <p class="email" data-user-email></p>
      <a class="admin-link" href="/admin" data-admin-link hidden>Gestisci inviti <span aria-hidden="true">→</span></a>
      <button type="button" data-logout>Esci dal tuo account</button>
    </div>

    <section class="my-tastings" aria-labelledby="my-tastings-title">
      <p class="label">Archivio personale</p>
      <h2 id="my-tastings-title">Le tue bevute.</h2>
      <p class="intro">Qui ritrovi ogni annotazione. Per modificarla o eliminarla, apri la relativa scheda della cantina.</p>
      <div data-my-tastings aria-live="polite"><p class="loading">Caricamento del taccuino…</p></div>
    </section>

    <section class="my-cellar" aria-labelledby="my-cellar-title">
      <p class="label">Cantina personale</p>
      <h2 id="my-cellar-title">In attesa.</h2>
      <p class="intro">Bottiglie già nella tua cantina, da tenere distinte dalle degustazioni.</p>
      <form class="cellar-form" data-cellar-form>
        <label>Produttore<input name="producer" list="maison-options" required placeholder="Es. Jacques Selosse" /></label>
        <label>Vino<input name="wine" required placeholder="Es. Substance" /></label>
        <label>Annata <input name="vintage" inputmode="numeric" maxlength="12" placeholder="Es. 2014" /></label>
        <label>Quantità <input name="quantity" type="number" min="1" max="99" value="1" required /></label>
        <button type="submit">Aggiungi in cantina <span aria-hidden="true">→</span></button>
        <p data-cellar-status aria-live="polite"></p>
      </form>
      <datalist id="maison-options">{maisons.map((maison) => <option value={maison.name} />)}</datalist>
      <div class="cellar-collection" data-cellar-collection aria-live="polite"><p class="loading">Caricamento della cantina…</p></div>
    </section>
  </section>
</BaseLayout>

<script>
  import { getUser, logout } from '@netlify/identity';
  import { aromas } from '../data/aromas';

  const name = document.querySelector<HTMLElement>('[data-user-name]');
  const email = document.querySelector<HTMLElement>('[data-user-email]');
  const admin = document.querySelector<HTMLElement>('[data-admin-link]');
  const logoutButton = document.querySelector<HTMLButtonElement>('[data-logout]');
  const tastingList = document.querySelector<HTMLElement>('[data-my-tastings]');
  const avatarImage = document.querySelector<HTMLImageElement>('[data-avatar-image]');
  const avatarFallback = document.querySelector<HTMLElement>('[data-avatar-fallback]');
  const avatarFile = document.querySelector<HTMLInputElement>('[data-avatar-file]');
  const avatarSave = document.querySelector<HTMLButtonElement>('[data-avatar-save]');
  const avatarStatus = document.querySelector<HTMLElement>('[data-avatar-status]');
  const cellarForm = document.querySelector<HTMLFormElement>('[data-cellar-form]');
  const cellarStatus = document.querySelector<HTMLElement>('[data-cellar-status]');
  const cellarCollection = document.querySelector<HTMLElement>('[data-cellar-collection]');
  const aromaById = new Map<string, { label: string; emoji: string }>(aromas.map(([id, label, emoji]) => [id, { label, emoji }]));
  const escapeHTML = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character] || character));
  const formatDate = (value: string) => new Intl.DateTimeFormat('it-IT', { dateStyle: 'long' }).format(new Date(`${value}T12:00:00`));

  type AccountTasting = {
    id: string; wine: string; drunkAt: string; place: string; rating: number; notes?: string; aromas?: string[];
    producer: { slug: string; name: string }; averageRating: number; ratingCount: number;
  };
  type CellarBottle = { id: string; producer: string; wine: string; vintage?: string; quantity: number };

  const drawTastings = (tastings: AccountTasting[]) => {
    if (!tastingList) return;
    if (!tastings.length) {
      tastingList.innerHTML = '<p class="empty">Il tuo taccuino è ancora vuoto. Apri una cantina e annota la tua prima bevuta.</p>';
      return;
    }
    tastingList.innerHTML = tastings.map((tasting) => {
      const flags = (tasting.aromas || []).map((id) => {
        const aroma = aromaById.get(id);
        return aroma ? `<span>${aroma.emoji} ${escapeHTML(aroma.label)}</span>` : '';
      }).join('');
      return `<article class="my-tasting">
        <p>${formatDate(tasting.drunkAt)} · ${escapeHTML(tasting.place)}</p>
        <h3>${escapeHTML(tasting.wine)}</h3>
        <a href="/cantine/${encodeURIComponent(tasting.producer.slug)}">${escapeHTML(tasting.producer.name)} <b aria-hidden="true">→</b></a>
        <strong>${tasting.rating.toFixed(1)} / 5 <small>· media storica ${tasting.averageRating.toFixed(1)} (${tasting.ratingCount})</small></strong>
        ${flags ? `<div class="my-aromas">${flags}</div>` : ''}
        ${tasting.notes ? `<div class="my-notes">${escapeHTML(tasting.notes)}</div>` : ''}
      </article>`;
    }).join('');
  };
  const drawCellar = (bottles: CellarBottle[]) => {
    if (!cellarCollection) return;
    if (!bottles.length) { cellarCollection.innerHTML = '<p class="empty">La tua cantina è ancora vuota.</p>'; return; }
    cellarCollection.innerHTML = bottles.map((bottle) => `<article class="cellar-bottle"><p>${escapeHTML(bottle.producer)}</p><h3>${escapeHTML(bottle.wine)}${bottle.vintage ? ` <span>${escapeHTML(bottle.vintage)}</span>` : ''}</h3><strong>${bottle.quantity} ${bottle.quantity === 1 ? 'bottiglia' : 'bottiglie'}</strong><button type="button" data-remove-cellar="${bottle.id}">Rimuovi</button></article>`).join('');
  };
  const loadCellar = async () => {
    const response = await fetch('/api/cantina-personale', { headers: { Accept: 'application/json' } });
    if (!response.ok) throw new Error();
    drawCellar((await response.json() as { bottles: CellarBottle[] }).bottles);
  };
  const readPhoto = (file: File) => new Promise<string>((resolve, reject) => {
    const reader = new FileReader(); reader.onload = () => resolve(String(reader.result)); reader.onerror = () => reject(new Error()); reader.readAsDataURL(file);
  });

  void getUser().then(async (user) => {
    if (!user) { window.location.href = '/accesso'; return; }
    const handle = typeof user.userMetadata?.handle === 'string' ? user.userMetadata.handle : user.name || 'Membro';
    if (name) name.textContent = handle;
    if (email) email.textContent = user.email || '';
    if (avatarFallback) avatarFallback.textContent = handle.slice(0, 1).toUpperCase();
    if (avatarImage) { avatarImage.src = '/api/profilo/avatar'; avatarImage.onload = () => { avatarImage.hidden = false; if (avatarFallback) avatarFallback.hidden = true; }; }
    if (admin && user.roles?.includes('admin')) admin.hidden = false;
    try {
      const response = await fetch('/api/account/bevute', { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error();
      drawTastings((await response.json() as { tastings: AccountTasting[] }).tastings);
    } catch {
      if (tastingList) tastingList.innerHTML = '<p class="empty">Non è stato possibile caricare il taccuino. Riprova tra poco.</p>';
    }
    try { await loadCellar(); } catch { if (cellarCollection) cellarCollection.innerHTML = '<p class="empty">Non è stato possibile caricare la cantina. Riprova tra poco.</p>'; }
  }).catch(() => { window.location.href = '/accesso'; });

  logoutButton?.addEventListener('click', async () => {
    await logout();
    window.location.href = '/';
  });

  avatarSave?.addEventListener('click', async () => {
    const file = avatarFile?.files?.[0];
    if (!file || !avatarStatus) { if (avatarStatus) avatarStatus.textContent = 'Scegli una foto prima di salvare.'; return; }
    if (file.size > 2 * 1024 * 1024) { avatarStatus.textContent = 'La foto supera il limite di 2 MB.'; return; }
    avatarStatus.textContent = 'Salvataggio foto…';
    try {
      const response = await fetch('/api/profilo/avatar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ photo: await readPhoto(file) }) });
      if (!response.ok) throw new Error();
      if (avatarImage) { avatarImage.src = `/api/profilo/avatar?aggiornata=${Date.now()}`; avatarImage.hidden = false; }
      if (avatarFallback) avatarFallback.hidden = true;
      avatarStatus.textContent = 'Foto profilo aggiornata.';
    } catch { avatarStatus.textContent = 'Non è stato possibile salvare la foto.'; }
  });

  cellarForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!cellarStatus) return;
    const fields = new FormData(cellarForm);
    cellarStatus.textContent = 'Aggiornamento in corso…';
    try {
      const response = await fetch('/api/cantina-personale', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ producer: fields.get('producer'), wine: fields.get('wine'), vintage: fields.get('vintage'), quantity: Number(fields.get('quantity')) }) });
      if (!response.ok) throw new Error();
      cellarForm.reset();
      cellarStatus.textContent = 'Bottiglia aggiunta alla tua cantina.';
      await loadCellar();
    } catch { cellarStatus.textContent = 'Non è stato possibile aggiornare la cantina.'; }
  });

  cellarCollection?.addEventListener('click', async (event) => {
    const id = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-cellar]')?.dataset.removeCellar;
    if (!id || !window.confirm('Rimuovere questa bottiglia dalla cantina?')) return;
    try { const response = await fetch(`/api/cantina-personale?id=${encodeURIComponent(id)}`, { method: 'DELETE' }); if (!response.ok) throw new Error(); await loadCellar(); }
    catch { if (cellarStatus) cellarStatus.textContent = 'Non è stato possibile rimuovere la bottiglia.'; }
  });
</script>

<style>
  .account { width: min(560px, calc(100% - 48px)); margin: auto; padding: 112px 0 70px; }
  .eyebrow, .label { margin: 0; color: var(--gold); font: 700 10px var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 22px 0 24px; font: 500 clamp(56px, 8vw, 86px)/.87 var(--display); letter-spacing: -.04em; }
  h1 em { color: var(--terre); font-weight: 400; }
  .intro { max-width: 500px; margin: 0; color: var(--sage); font-size: 19px; line-height: 1.55; }
  .account-panel { display: grid; gap: 12px; margin-top: 45px; padding: 28px; border: 1px solid var(--line); background: rgba(255,255,255,.32); }
  .avatar-editor { display: grid; grid-template-columns: 64px 1fr auto; gap: 12px 16px; align-items: center; padding-bottom: 23px; border-bottom: 1px solid var(--line); }
  .account-avatar { display: grid; place-items: center; width: 58px; height: 58px; overflow: hidden; border: 1px solid var(--gold); border-radius: 50%; color: var(--gold); font: 500 31px var(--display); }
  .account-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .avatar-editor label { display: grid; gap: 5px; color: var(--terre); font: 700 9px var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  .avatar-editor label span, .avatar-editor > p { margin: 0; color: var(--sage); font: 600 8px var(--sans); letter-spacing: .05em; text-transform: uppercase; }
  .avatar-editor > p { grid-column: 2 / -1; }
  .outline-button { padding: 10px 12px; border-color: var(--line); color: var(--terre); background: transparent; }
  .name { margin: 0; font: 500 42px/.95 var(--display); }
  .email { margin: 0 0 15px; color: var(--sage); }
  .admin-link { justify-self: start; color: var(--terre); font: 700 10px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  button { justify-self: start; padding: 13px 18px; border: 1px solid var(--ink); color: var(--paper); background: var(--ink); font: 700 10px var(--sans); letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
  .my-tastings { margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--line); }
  h2 { margin: 12px 0 18px; font: 500 clamp(42px, 6vw, 58px)/.92 var(--display); letter-spacing: -.03em; }
  .my-tastings .intro { font-size: 17px; }
  :global(.loading), :global(.empty) { margin: 27px 0 0; color: var(--sage); }
  :global(.my-tasting) { padding: 25px 0; border-bottom: 1px solid var(--line); }
  :global(.my-tasting > p) { margin: 0 0 7px; color: var(--terre); font: 700 9px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  :global(.my-tasting h3) { margin: 0; font: 500 30px/1 var(--display); }
  :global(.my-tasting > a) { display: inline-block; margin-top: 9px; border-bottom: 1px solid var(--gold); color: var(--terre); font: 700 9px var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  :global(.my-tasting > strong) { display: block; margin-top: 13px; color: var(--gold); font: 700 11px var(--sans); }
  :global(.my-tasting > strong small) { color: var(--sage); font-weight: 600; }
  :global(.my-aromas) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 13px; }
  :global(.my-aromas span) { padding: 4px 7px; border: 1px solid var(--line); color: var(--terre); font: 600 9px var(--sans); }
  :global(.my-notes) { margin-top: 13px; line-height: 1.58; white-space: pre-line; }
  .my-cellar { margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--line); }
  .cellar-form { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 29px; padding: 24px; border: 1px solid var(--line); background: rgba(255,255,255,.22); }
  .cellar-form label { display: grid; gap: 7px; color: var(--terre); font: 700 9px var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  .cellar-form input { width: 100%; padding: 10px 0; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; outline: none; color: var(--ink); background: transparent; font: 400 16px var(--serif); }
  .cellar-form input:focus { border-color: var(--gold); }
  .cellar-form button { justify-self: start; }
  .cellar-form > p { margin: 0; align-self: center; color: var(--sage); font: 600 9px var(--sans); letter-spacing: .06em; }
  .cellar-collection { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 23px; }
  :global(.cellar-bottle) { padding: 20px; border: 1px solid var(--line); background: rgba(255,255,255,.22); }
  :global(.cellar-bottle p) { margin: 0 0 7px; color: var(--terre); font: 700 9px var(--sans); letter-spacing: .09em; text-transform: uppercase; }
  :global(.cellar-bottle h3) { margin: 0; font: 500 28px/1 var(--display); }
  :global(.cellar-bottle h3 span) { color: var(--terre); font-style: italic; font-weight: 400; }
  :global(.cellar-bottle strong) { display: block; margin-top: 12px; color: var(--sage); font: 700 9px var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  :global(.cellar-bottle button) { margin-top: 15px; padding: 0; border: 0; border-bottom: 1px solid currentColor; color: #9d4031; background: transparent; font: 700 9px var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 650px) { .account { width: min(100% - 32px, 560px); padding-top: 74px; } .account-panel { padding: 21px 17px; } .avatar-editor { grid-template-columns: 58px 1fr; } .avatar-editor .outline-button { grid-column: 2; } .cellar-form, .cellar-collection { grid-template-columns: 1fr; } }
</style>
