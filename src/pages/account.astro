    (tastingEditorForm.elements.namedItem('wine') as HTMLInputElement).value = item.wine;
    (tastingEditorForm.elements.namedItem('drunkAt') as HTMLInputElement).value = item.drunkAt;
    (tastingEditorForm.elements.namedItem('place') as HTMLInputElement).value = item.place;
    (tastingEditorForm.elements.namedItem('price') as HTMLInputElement).value = typeof item.price === 'number' ? String(item.price) : '';
