    if (profileBox) {
      if (!data.profile.enough) { profileBox.innerHTML = `<div class="profile-empty"><p>Il tuo Champagne</p><h3>Stiamo iniziando a conoscerti.</h3><span>Hai registrato ${data.profile.sampleSize} ${data.profile.sampleSize === 1 ? 'degustazione' : 'degustazioni'}. Dopo almeno tre, il profilo inizierà a mostrare preferenze con basi sufficienti.</span></div>`; if (profileBoxSecondary) profileBoxSecondary.innerHTML = ''; }
      else {
        const rows = [['Stile preferito', data.profile.styles.favorite, data.profile.styles.covered], ['Vitigno ricorrente', data.profile.grapes.favorite, data.profile.grapes.covered], ['Dosage ricorrente', data.profile.dosage.favorite, data.profile.dosage.covered]].map(([label, value, covered]) => `<article><p>${label}</p><h3>${value || 'Dati insufficienti'}</h3><span>${Number(covered) ? `basato su ${covered} schede con dato dichiarato` : 'non disponibile nelle schede degustate'}</span></article>`).join('');
        const taste = data.profile.experience?.description.length ? data.profile.experience.description.join(' · ') : 'Dati sensoriali insufficienti'; const producers = data.profile.producers.length ? data.profile.producers.map((item) => `${escapeHTML(item.producer)} · ${item.rating.toFixed(1)}`).join('<br>') : 'Continua a degustare lo stesso produttore per leggere una media prudente.';
        profileBox.innerHTML = `<div class="profile-grid">${rows}<article><p>Profilo</p><h3>${escapeHTML(taste)}</h3><span>basato sulle impressioni che hai registrato</span></article></div>`;
        if (profileBoxSecondary) profileBoxSecondary.innerHTML = `<div class="taste-secondary-record"><p>Produttori preferiti</p><strong>${producers}</strong></div><div class="taste-secondary-record"><p>Lo ricompreresti?</p><strong>${data.profile.repurchase ? `${data.profile.repurchase.percent}%` : 'Dati insufficienti'}</strong><span>${data.profile.repurchase ? `${data.profile.repurchase.yes} su ${data.profile.repurchase.total} risposte` : 'servono almeno tre risposte'}</span></div><div class="territory"><p>Territorio letto con cautela</p><span>Aree: ${data.profile.territory.areas.length ? escapeHTML(data.profile.territory.areas.join(' · ')) : 'dati insufficienti'}. Cru certi: ${data.profile.territory.crus.length ? escapeHTML(data.profile.territory.crus.join(' · ')) : 'nessuno ancora'}.</span></div>`;
      }
