  tastingEditorForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!editingTasting || !tastingEditorStatus) return;
    tastingEditorStatus.textContent = 'Aggiornamento del taccuino…';
    const values = new FormData(tastingEditorForm);
    try {
      const response = await fetch(`/api/cantine/${encodeURIComponent(editingTasting.producer.slug)}/bevute`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        id: editingTasting.id, wine: values.get('wine'), drunkAt: values.get('drunkAt'), place: values.get('place'), price: values.get('price'), rating: Number(values.get('rating')),
        notes: values.get('notes'), wouldRepurchase: values.get('wouldRepurchase') === 'yes' ? true : values.get('wouldRepurchase') === 'no' ? false : undefined,
        aromas: editingTasting.aromas || [], sensory: editingTasting.sensory || { body: 50, tannin: 50, sweetness: 50, acidity: 50 }, experience: editingTasting.experience,
      }) });
      const data = await response.json() as { error?: string };
      if (!response.ok) throw new Error(data.error || 'Non è stato possibile salvare la modifica.');
      await load(); tastingEditor?.close(); if (tastingStatus) tastingStatus.textContent = 'Degustazione aggiornata nel taccuino e nel passaporto.';
    } catch (error) { tastingEditorStatus.textContent = error instanceof Error ? error.message : 'Non è stato possibile salvare la modifica.'; }
  });
