    try { const response = await fetch(`/api/cantine/${encodeURIComponent(producer)}/bevute?id=${encodeURIComponent(id)}`, { method: 'DELETE' }); if (!response.ok) throw new Error(); await load(); if (tastingStatus) tastingStatus.textContent = 'Bevuta eliminata dal taccuino.'; } catch { if (tastingStatus) tastingStatus.textContent = 'Non è stato possibile eliminare la bevuta.'; }
  }));
