    const renderStamp = (stamp: PassportStamp) => `<button type="button" class="passport-stamp stamp--${escapeHTML(stamp.stampShape)} stamp--${escapeHTML(stamp.stampSize)} stamp--v${stamp.stampVariant}${stamp.isNew ? ' is-new' : ''}" data-stamp-id="${escapeHTML(stamp.id)}" style="--stamp-x:${stamp.position.x}%;--stamp-y:${stamp.position.y}%;--stamp-mobile-x:${stamp.position.mobileX}%;--stamp-mobile-y:${stamp.position.mobileY}%;--stamp-rotation:${stamp.rotation}deg" aria-label="${escapeHTML(stamp.name)}"><i aria-hidden="true">${escapeHTML(stamp.visualMotif)}</i><b>${escapeHTML(stamp.name)}</b>${stamp.isNew ? '<small>Nouveau</small>' : ''}</button>`;
