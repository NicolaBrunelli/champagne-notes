---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---

<BaseLayout title="Lo Champagne, con calma — Brunelli Nicola">
  <section class="home-hero">
    <div class="topography" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">Archivio personale · Champagne</p>
      <h1>Lo Champagne,<br /><em>con calma.</em></h1>
      <p class="lead">Appunti di vigna, craie, vendemmie, territori e vini che meritano tempo e attenzione.</p>
      <p class="byline">Scritto e redatto da Brunelli Nicola</p>
    </div>
    <div class="hero-footer">
      <span>49° N · Champagne, France</span>
      <a href="#archivio">Esplora l’archivio <b aria-hidden="true">↓</b></a>
    </div>
  </section>

  <section class="sections" id="archivio" aria-label="Sezioni dell'archivio">
    <a href="/storia-e-metodo"><span>01</span><strong>Storia<br />e metodo</strong><small>Dalla vigna alla presa di spuma</small></a>
    <a href="/territorio"><span>02</span><strong>Territorio</strong><small>Craie, cru e paesaggi</small></a>
    <a href="/cantine-e-vini"><span>03</span><strong>Cantine<br />e vini</strong><small>Maison e vigneron per area</small></a>
  </section>

  <section class="latest">
    <div class="latest-intro"><p class="eyebrow">In evidenza</p><h2>Un archivio costruito con attenzione, un appunto alla volta.</h2></div>
    <div class="cards"><ArticleCard category="In preparazione" title="Le prossime letture trovano qui il loro posto." excerpt="I testi, le bottiglie e le mappe entreranno nell’archivio seguendo il ritmo delle scoperte." /></div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; isolation: isolate; display: grid; min-height: min(750px, calc(100vh - 83px)); align-content: center; overflow: hidden; padding: clamp(76px, 12vw, 154px) max(24px, 7vw) 42px; border-bottom: 1px solid var(--line); }
  .home-hero::before { content: ''; position: absolute; inset: 20px; z-index: -1; border: 1px solid rgba(32, 52, 43, .12); pointer-events: none; }
  .topography { position: absolute; inset: 0; z-index: -2; opacity: .3; background: repeating-radial-gradient(ellipse at 80% 50%, transparent 0 35px, rgba(32, 52, 43, .14) 36px 37px, transparent 38px 62px); transform: rotate(-12deg) scale(1.55); }
  .hero-content { width: min(1050px, 100%); }
  .eyebrow { margin: 0; color: var(--gold); font: 700 10px var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 22px 0 27px; color: var(--ink); font: 500 clamp(72px, 11vw, 156px)/.84 var(--display); letter-spacing: -.048em; }
  h1 em { color: var(--terre); font-weight: 400; }
  .lead { max-width: 480px; margin: 0; font-size: clamp(19px, 2vw, 24px); line-height: 1.45; }
  .byline { margin: 22px 0 0; color: var(--sage); font: 600 10px var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .hero-footer { display: flex; justify-content: space-between; gap: 20px; margin-top: clamp(58px, 10vw, 126px); color: var(--sage); font: 600 10px var(--sans); letter-spacing: .11em; text-transform: uppercase; }
  .hero-footer a { color: var(--terre); } .hero-footer b { margin-left: 8px; color: var(--gold); font-size: 16px; }
  .sections { width: min(1180px, calc(100% - 48px)); display: grid; grid-template-columns: repeat(3, 1fr); margin: 96px auto 0; border: 1px solid var(--line); }
  .sections a { min-height: 270px; display: flex; flex-direction: column; padding: 24px; border-right: 1px solid var(--line); background: rgba(255, 255, 255, .13); transition: background .3s ease, transform .3s ease; }
  .sections a:last-child { border-right: 0; }
  .sections a:hover { background: rgba(217, 212, 200, .48); transform: translateY(-4px); }
  .sections span { color: var(--gold); font: 700 10px var(--sans); letter-spacing: .14em; }
  .sections strong { margin-top: auto; color: var(--ink); font: 500 39px/.94 var(--display); letter-spacing: -.025em; }
  .sections small { margin-top: 18px; color: var(--sage); font: 600 10px var(--sans); letter-spacing: .07em; text-transform: uppercase; }
  .latest { width: min(1180px, calc(100% - 48px)); display: grid; grid-template-columns: 1fr 1fr; gap: min(11vw, 150px); margin: 120px auto 0; }
  .latest h2 { max-width: 560px; margin: 16px 0 0; color: var(--ink); font: 500 clamp(42px, 5vw, 64px)/.97 var(--display); letter-spacing: -.025em; }
  @media (max-width: 800px) { .home-hero { min-height: 620px; }.sections, .latest { grid-template-columns: 1fr; }.sections a { min-height: 170px; border-right: 0; border-bottom: 1px solid var(--line); }.sections a:last-child { border-bottom: 0; }.sections strong { margin-top: 34px; }.latest { gap: 35px; margin-top: 72px; } }
  @media (max-width: 650px) { .home-hero { min-height: 590px; padding-inline: 24px; }.home-hero::before { inset: 12px; }.hero-footer { align-items: end; }.hero-footer span { white-space: nowrap; }.sections, .latest { width: min(100% - 32px, 1180px); }.sections { margin-top: 62px; }.sections strong { font-size: 34px; } }
</style>
