---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---
<BaseLayout>
  <section class="intro">
    <p class="eyebrow">Archivio personale</p>
    <h1>Lo Champagne,<br />con calma.</h1>
    <p class="lead">Un luogo privato per raccogliere storie, territori, produttori e vini che meritano tempo e attenzione.</p>
    <p class="byline">Scritto e redatto da Brunelli Nicola</p>
  </section>
  <section class="sections" aria-label="Sezioni dell'archivio">
    <a href="/storia-e-metodo"><span>01</span><strong>Storia<br />e metodo</strong></a>
    <a href="/territorio"><span>02</span><strong>Territorio</strong></a>
    <a href="/cantine-e-vini"><span>03</span><strong>Cantine<br />e vini</strong></a>
  </section>
  <section class="latest">
    <div><p class="eyebrow">In evidenza</p><h2>Un archivio che cresce con le tue letture.</h2></div>
    <div class="cards"><ArticleCard category="Prossimamente" title="I primi appunti prenderanno forma qui." excerpt="Quando condividerai i testi, li trasformeremo in pagine editoriali ordinate e piacevoli da leggere." /></div>
  </section>
</BaseLayout>
<style>
  .intro { width: min(1000px, calc(100% - 48px)); margin: auto; padding: 135px 0 100px; text-align: center; }
  .eyebrow { color: var(--gold); font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 16px 0 28px; font-size: clamp(54px, 10vw, 118px); font-weight: 400; letter-spacing: -.05em; line-height: .9; }
  .lead { max-width: 560px; margin: auto; font-size: 21px; }
  .byline { margin-top:25px; color:var(--sage); font:600 11px var(--sans); letter-spacing:.1em; text-transform:uppercase; }
  .sections { width: min(1180px, calc(100% - 48px)); display: grid; grid-template-columns: repeat(3, 1fr); margin: auto; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .sections a { min-height: 205px; display: flex; flex-direction: column; justify-content: space-between; padding: 22px; border-right: 1px solid var(--line); transition: background .2s; } .sections a:last-child { border: 0; } .sections a:hover { background: #eeeadf; }
  .sections span { color: var(--gold); font-family: var(--sans); font-size: 12px; }.sections strong { font-size: 30px; font-weight: 400; line-height: 1.06; }
  .latest { width: min(1180px, calc(100% - 48px)); display: grid; grid-template-columns: 1fr 1fr; gap: 100px; margin: 115px auto 0; }.latest h2 { font-size: clamp(33px, 4vw, 52px); font-weight: 400; line-height: 1.06; }
  @media (max-width: 800px) { .intro { padding: 85px 0 65px; }.sections { grid-template-columns: 1fr; }.sections a {border-right:0;border-bottom:1px solid var(--line);min-height:140px}.sections a:last-child {border-bottom:0}.latest { grid-template-columns: 1fr; gap: 30px; margin-top: 65px; } }
  @media (max-width: 520px) { .sections { width: min(100% - 32px, 1180px); }.sections a { min-height: 150px; padding: 15px; }.sections strong { font-size: 23px; } }
</style>
