---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accesso riservato — Lo Champagne, con calma">
  <section class="access">
    <p class="eyebrow">Archivio personale</p>
    <h1>Accesso<br /><em>riservato.</em></h1>
    <p class="intro">Il tuo profilo custodisce le degustazioni che inserisci. Gli utenti invitati possono consultare i voti della comunità e contribuire alla media storica di ogni vino.</p>
    <p class="invite-note">L’accesso è personale e solo su invito. Hai ricevuto un invito? Apri il link nell’email per scegliere la tua password.</p>

    <div class="access-panel" data-auth-panel>
      <form data-login-form>
        <label>Email
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>Password
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <p data-auth-status aria-live="polite"></p>
        <button type="submit">Accedi <span aria-hidden="true">→</span></button>
        <button class="text-button" type="button" data-recovery-trigger>Password dimenticata?</button>
      </form>
    </div>

    <div class="access-panel" data-invite-panel hidden>
      <form data-invite-form>
        <p>Imposta la password per attivare l’invito personale.</p>
        <label>Nuova password
          <input name="password" type="password" autocomplete="new-password" minlength="8" required />
        </label>
        <p data-invite-status aria-live="polite"></p>
        <button type="submit">Attiva l’accesso <span aria-hidden="true">→</span></button>
      </form>
    </div>

    <div class="access-panel" data-recovery-panel hidden>
      <form data-recovery-form>
        <p>Inserisci l’indirizzo associato al tuo invito: riceverai un link sicuro per scegliere una nuova password.</p>
        <label>Email
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <p data-recovery-status aria-live="polite"></p>
        <button type="submit">Invia il link <span aria-hidden="true">→</span></button>
        <button class="text-button" type="button" data-login-trigger>Torna all’accesso</button>
      </form>
    </div>

    <div class="access-panel" data-reset-panel hidden>
      <form data-reset-form>
        <p>Scegli una nuova password per il tuo account.</p>
        <label>Nuova password
          <input name="password" type="password" autocomplete="new-password" minlength="8" required />
        </label>
        <p data-reset-status aria-live="polite"></p>
        <button type="submit">Salva la password <span aria-hidden="true">→</span></button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { acceptInvite, getUser, handleAuthCallback, login, requestPasswordRecovery, updateUser } from '@netlify/identity';

  const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]');
  const inviteForm = document.querySelector<HTMLFormElement>('[data-invite-form]');
  const authPanel = document.querySelector<HTMLElement>('[data-auth-panel]');
  const invitePanel = document.querySelector<HTMLElement>('[data-invite-panel]');
  const recoveryPanel = document.querySelector<HTMLElement>('[data-recovery-panel]');
  const resetPanel = document.querySelector<HTMLElement>('[data-reset-panel]');
  const recoveryForm = document.querySelector<HTMLFormElement>('[data-recovery-form]');
  const resetForm = document.querySelector<HTMLFormElement>('[data-reset-form]');
  const recoveryTrigger = document.querySelector<HTMLButtonElement>('[data-recovery-trigger]');
  const loginTrigger = document.querySelector<HTMLButtonElement>('[data-login-trigger]');
  const status = document.querySelector<HTMLElement>('[data-auth-status]');
  const inviteStatus = document.querySelector<HTMLElement>('[data-invite-status]');
  const recoveryStatus = document.querySelector<HTMLElement>('[data-recovery-status]');
  const resetStatus = document.querySelector<HTMLElement>('[data-reset-status]');
  let inviteToken = '';

  const goToArchive = () => { window.location.href = '/cantine-e-vini'; };
  const showPanel = (panel: HTMLElement | null) => {
    [authPanel, invitePanel, recoveryPanel, resetPanel].forEach((item) => { if (item) item.hidden = item !== panel; });
  };
  (async () => {
    try {
      const result = await handleAuthCallback();
      if (result?.type === 'invite' && result.token) {
        inviteToken = result.token;
        showPanel(invitePanel);
        return;
      }
      if (result?.type === 'recovery') {
        showPanel(resetPanel);
        return;
      }
      const user = await getUser();
      if (user) goToArchive();
    } catch {
      if (status) status.textContent = 'L’invito non è valido o non può essere elaborato.';
    }
  })();

  recoveryTrigger?.addEventListener('click', () => showPanel(recoveryPanel));
  loginTrigger?.addEventListener('click', () => showPanel(authPanel));

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;
    const fields = new FormData(loginForm);
    status.textContent = 'Accesso in corso…';
    try {
      await login(String(fields.get('email')), String(fields.get('password')));
      goToArchive();
    } catch {
      status.textContent = 'Email o password non riconosciute.';
    }
  });

  inviteForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!inviteToken || !inviteStatus) return;
    inviteStatus.textContent = 'Attivazione in corso…';
    try {
      const fields = new FormData(inviteForm);
      await acceptInvite(inviteToken, String(fields.get('password')));
      goToArchive();
    } catch {
      inviteStatus.textContent = 'Non è stato possibile attivare l’invito.';
    }
  });

  recoveryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!recoveryStatus) return;
    recoveryStatus.textContent = 'Invio del link in corso…';
    try {
      const fields = new FormData(recoveryForm);
      await requestPasswordRecovery(String(fields.get('email')));
      recoveryStatus.textContent = 'Controlla la tua email per proseguire.';
    } catch {
      recoveryStatus.textContent = 'Non è stato possibile inviare il link.';
    }
  });

  resetForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!resetStatus) return;
    resetStatus.textContent = 'Salvataggio in corso…';
    try {
      const fields = new FormData(resetForm);
      await updateUser({ password: String(fields.get('password')) });
      goToArchive();
    } catch {
      resetStatus.textContent = 'Non è stato possibile salvare la password.';
    }
  });
</script>

<style>
  .access { width: min(560px, calc(100% - 48px)); margin: auto; padding: 112px 0 70px; }
  .eyebrow { margin: 0; color: var(--gold); font: 700 10px var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 22px 0 24px; font: 500 clamp(56px, 8vw, 86px)/.87 var(--display); letter-spacing: -.04em; }
  h1 em { color: var(--terre); font-weight: 400; }
  .intro { max-width: 500px; margin: 0; color: var(--sage); font-size: 19px; line-height: 1.55; }
  .invite-note { max-width: 460px; margin: 20px 0 0; color: var(--terre); font: 700 10px/1.6 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  .access-panel { margin-top: 45px; padding: 28px; border: 1px solid var(--line); background: rgba(255,255,255,.32); }
  form { display: grid; gap: 21px; }
  label { display: grid; gap: 8px; color: var(--ink); font: 700 10px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  input { width: 100%; padding: 11px 0; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; outline: none; color: var(--ink); background: transparent; font: 400 18px var(--serif); }
  input:focus { border-color: var(--gold); }
  form p { margin: 0; color: var(--sage); font-size: 15px; }
  button { justify-self: start; padding: 13px 18px; border: 1px solid var(--ink); color: var(--paper); background: var(--ink); font: 700 10px var(--sans); letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: background .25s ease, color .25s ease; }
  button:hover { color: var(--ink); background: transparent; }
  .text-button { padding: 0; border: 0; color: var(--sage); background: transparent; font-size: 11px; letter-spacing: .06em; text-decoration: underline; text-underline-offset: 4px; }
  .text-button:hover { color: var(--terre); background: transparent; }
  @media (max-width: 650px) { .access { width: min(100% - 32px, 560px); padding-top: 74px; } .access-panel { padding: 21px 17px; } }
</style>
